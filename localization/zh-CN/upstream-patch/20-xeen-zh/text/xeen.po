msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:377 assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:384 assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:391
#: assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:398 assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:405
msgid "The winch clatters, and the hatch moves on its chains."
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:39
msgid ""
"BOOK OF ENDURANCE. One of Darzog's own studies, written for his apprentices; whoever reads it to the end is changed by it. +5 Endurance (permanent)."
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:409 assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:415
msgid "Works gate"
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:411
msgid ""
"An iron gate bars the way to the east stair. Its chains run off along the walls toward the south: the winch that raises it must be in the assembly hall."
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:414
msgid "The works gate stands open."
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:418 assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:424
msgid "Works gate winch"
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:423
msgid ""
"Chains rattle: across the works, the gate to the east stair grinds up."
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:43 assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:51
msgid "Book of Intellect"
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:446
msgid "The disc hums and glides down the Well."
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:45
msgid "You have already learned what the book of intellect can teach."
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:450 assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:453
msgid "Cell block door"
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:456 assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:459
msgid "Crypt door"
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:462 assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:465
msgid "Guardroom door"
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:468 assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:471
msgid "Storeroom door"
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:50
msgid ""
"BOOK OF INTELLECT. One of Darzog's own studies, written for his apprentices; whoever reads it to the end is changed by it. +5 Intellect (permanent)."
msgstr ""

#: assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:54 assets_dev/worlds/xeen/events/maps/xeen_xd12.lua:62
