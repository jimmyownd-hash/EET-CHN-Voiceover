msgstr "{minutes} 分钟"

msgid "Add: {member}'s buffs, heals and cures"
msgstr "添加：{member} 的增益、治疗和解除状态"

msgid "Upkeep key cleared"
msgstr "已清除维持键"

msgid "{key} is taken by {action}. Choose another key."
msgstr "{key} 已被“{action}”占用，请选择其他按键。"

msgid "Upkeep key: {key}"
msgstr "维持键：{key}"

msgid "UPKEEP KEY"
msgstr "维持键"

msgid "Press the key to use. Escape keeps the old one."
msgstr "请按下要使用的键。按 Esc 保留原来的键。"

msgid "Click the box, then press a key. A right click clears it."
msgstr "点击方框，再按一个键。右键点击可清除。"

msgid "One key for the whole party: each ready member casts what is due on their list."
msgstr "全队共用一个键：每位准备好的成员会施放自己列表中到期的法术。"

msgid "Attack, upkeep and the quick keys, per member"
msgstr "每位成员的攻击、维持与快捷键"

msgid "Nothing to add"
msgstr "没有可添加的"

msgid "Copied {member}'s upkeep"
msgstr "已复制 {member} 的维持列表"

msgid "Add to {member}'s upkeep"
msgstr "添加到 {member} 的维持列表"

msgid "Quicksave {number}"
msgstr "快速存档 {number}"

msgid "{hours} h {minutes} min"
msgstr "{hours} 小时 {minutes} 分钟"

